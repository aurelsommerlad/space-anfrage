# Kopiere diese Datei nach .env.local und trage dort echte Werte ein.
# .env.local wird nicht eingecheckt. Auf Vercel: Project Settings -> Environment Variables.
# Alle Variablen sind ausschließlich serverseitig (kein NEXT_PUBLIC_-Präfix).

# Datenquelle für Verfügbarkeit und Anfragen: "demo" (Beispieldaten) oder "apaleo".
# "apaleo" ist vorbereitet, aber noch nicht implementiert.
BOOKING_DATA_SOURCE=demo

# apaleo (Client-Credentials-Flow) – noch ungenutzt
APALEO_CLIENT_ID=
APALEO_CLIENT_SECRET=
APALEO_PROPERTY_ID=
APALEO_UNIT_GROUP_ID=

# Empfänger für Anfragen (späterer E-Mail-Versand) – noch ungenutzt
REQUEST_NOTIFICATION_EMAIL=

# Erlaubte Seiten, die /embed per iframe einbinden dürfen (CSP frame-ancestors).
# Leerzeichengetrennt, z. B. "https://www.example.com https://example.com".
# Leer = nur dieselbe Domain.
EMBED_FRAME_ANCESTORS=
