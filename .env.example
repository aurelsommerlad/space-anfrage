# Kopiere diese Datei nach .env.local und trage dort echte Werte ein.
# .env.local wird nicht eingecheckt. Auf Vercel: Project Settings -> Environment Variables,
# getrennt nach "Preview" (Testumgebung) und "Production".
# Alle Variablen sind ausschließlich serverseitig (kein NEXT_PUBLIC_-Präfix).

# ---------------------------------------------------------------------------
# Betriebsart
# ---------------------------------------------------------------------------
# demo = Beispieldaten, nichts wird gespeichert oder versendet (deutlich gekennzeichnet)
# live = apaleo-Verfügbarkeit, Speicherung in Postgres, E-Mail-Versand
# Ist "live" gesetzt, aber eine Pflichtvariable fehlt oder ist ungültig, ist die
# Anfragestrecke gesperrt (Hinweis auf stay@unique-places.com) – kein Rückfall auf Demo.
BOOKING_MODE=demo

# ---------------------------------------------------------------------------
# apaleo (nur lesend; OAuth2 Client Credentials, Scope: availability.read)
# ---------------------------------------------------------------------------
APALEO_CLIENT_ID=
APALEO_CLIENT_SECRET=
# HØV by UNIQUE PLACES
APALEO_PROPERTY_ID=ALTUS
# Kategorie SPACE (MeetingRoom, Einheit ALTUS-SIQ)
APALEO_UNIT_GROUP_ID=ALTUS-SPACE
# Optional, nur für Tests: andere Endpunkte (Standard: https://api.apaleo.com, https://identity.apaleo.com)
# APALEO_API_URL=
# APALEO_IDENTITY_URL=

# ---------------------------------------------------------------------------
# Datenbank (Postgres, z. B. Neon über den Vercel Marketplace)
# Je Umgebung eine eigene Datenbank (Preview ≠ Production). Tabellen werden automatisch angelegt.
# ---------------------------------------------------------------------------
DATABASE_URL=

# ---------------------------------------------------------------------------
# E-Mail (Resend). Absenderdomain in Resend verifizieren (SPF, DKIM; DMARC empfohlen).
# ---------------------------------------------------------------------------
RESEND_API_KEY=
# z. B. SPACE im HØV <anfrage@mail.unique-places.com> – Domain muss in Resend verifiziert sein
MAIL_FROM=
# Interne Benachrichtigung (mehrere Adressen mit Komma)
MAIL_INTERNAL_TO=stay@unique-places.com
# Antwortadresse der Eingangsbestätigung an Interessenten
MAIL_REPLY_TO=stay@unique-places.com
# Optional: "log" schreibt Mails nur ins Protokoll (nur Testumgebung, in Production gesperrt)
# MAIL_TRANSPORT=resend
# RESEND_API_URL=

# ---------------------------------------------------------------------------
# Sicherheit
# ---------------------------------------------------------------------------
# Zufälliger Schlüssel (mind. 32 Zeichen) zum Pseudonymisieren von IP-Adressen beim Rate-Limit,
# z. B. erzeugen mit: openssl rand -hex 32
REQUEST_HASH_SECRET=
# Zugang zur internen Übersicht /intern (HTTP Basic Auth; Passwort mind. 12 Zeichen)
ADMIN_USER=
ADMIN_PASSWORD=
# Schützt /api/cron/mail-retry (Vercel Cron sendet "Authorization: Bearer <CRON_SECRET>"), mind. 16 Zeichen
CRON_SECRET=

# ---------------------------------------------------------------------------
# Website
# ---------------------------------------------------------------------------
# Datenschutzerklärung, auf die Formular und Bestätigungs-Mail verlinken
PRIVACY_URL=https://unique-places.com/datenschutz
# Websites, die /embed per iframe einbinden dürfen (CSP frame-ancestors + postMessage).
# Vollständige Origins ohne Pfad, getrennt durch Leerzeichen oder Komma.
# Wird beim Build gelesen: nach einer Änderung neu deployen.
EMBED_ALLOWED_ORIGINS=https://unique-places.com https://www.unique-places.com
